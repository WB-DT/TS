# QuoteFlow settings. Copy to .env and fill in what you need:
#   cp .env.example .env
# Everything here is optional for a local demo run: with no .env at all the app
# uses SQLite in db/quotes.sqlite, seeds the demo workspace, and starts on :3000.
# config.js is the one place these are read, and it validates them at startup.

# --- basics ---
NODE_ENV=development            # production turns on secure cookies and strict config checks
PORT=3000
APP_ORIGIN=                     # e.g. https://quoteflow.example.com; required in production
SESSION_SECRET=                 # 32+ random characters; required in production
                                # Without it a random secret is made per start, so every restart signs everyone out.

# --- demo data ---
SEED_DEMO_DATA=true             # seed the demo people, quotes and files on first start

# --- database ---
DB_CLIENT=better-sqlite3        # or mssql for Azure SQL
# SQLITE_PATH=./db/quotes.sqlite   # better-sqlite3 file; default is db/quotes.sqlite beside db/config.js
AZURE_SQL_SERVER=
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# --- Microsoft Entra ID (sign-in and Dataverse) ---
# The tenant and client id default to the deployed app registration in config.js.
# Only set these to point a checkout at a different org or app.
DATAVERSE_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=            # only for the server-side Entra sign-in flow
AZURE_REDIRECT_URI=             # must match the app registration's redirect URI

# --- document reading (optional) ---
# Without these the "Read a document" page reports that extraction is unavailable.
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# --- Dataverse log sync ---
DATAVERSE_SYNC_MAX_ROWS=20000
DATAVERSE_SYNC_TIMEOUT_MS=120000

# --- first Manager ---
# Comma-separated emails granted the Manager role at startup.
MANAGER_EMAILS=

# --- housekeeping ---
UPLOAD_RETENTION_DAYS=90        # npm run uploads:prune removes unreferenced files older than this
LOG_LEVEL=info                  # error, warn or info
LOG_FORMAT=                     # text (default in development) or json (default in production)

# --- GitHub Pages publishing (scripts/publish-pages.js) ---
PAGES_REMOTE=origin
PAGES_BRANCH=quoteflow-pages
